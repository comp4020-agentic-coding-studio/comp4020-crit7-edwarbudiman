---
// "My Plan" always means the current semester's plan.
import { currentSemester } from "../../lib/plans";

const current = currentSemester();
if (current) return Astro.redirect(`/plan/${current.id}/`);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>No current semester · ANU Course Planner</title>
  </head>
  <body>
    <nav aria-label="site"><a href="/">Dashboard</a></nav>
    <main><h1>No semester is running</h1></main>
  </body>
</html>
