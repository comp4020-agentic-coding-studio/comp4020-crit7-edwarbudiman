---
// A semester plan, in Canvas's course view. It opens with the planning steps
// (1 program, 2 courses); once there's a program, both sections show the same
// skill tree, so a course sits in the same place in each:
// - Overview: the tree beside the Requirements checklist (what's left to
//   finish the program);
// - Add Course: a short intro, the semester's selection (four slots and
//   Submit), and the tree — click a tile, then "Add to this semester".
// ?tab= switches the tree between the program's path, a major/specialisation
// (?major=, default the closest) and all courses; ?course= opens a tile's
// detail above the side panel.
import CanvasLayout from "../../../layouts/CanvasLayout.astro";
import CourseDetail from "../../../components/CourseDetail.astro";
import PlanHeader from "../../../components/PlanHeader.astro";
import PlanSteps from "../../../components/PlanSteps.astro";
import RequirementTracker from "../../../components/RequirementTracker.astro";
import PlanIntro from "../../../components/PlanIntro.astro";
import SelectionBar from "../../../components/SelectionBar.astro";
import SkillTree from "../../../components/SkillTree.astro";
import { getCourse } from "../../../lib/catalogue";
import { currentSemester, formatRange } from "../../../lib/plans";
import { type Tab, canAdd, planView, tiers } from "../../../lib/planner";

const params = Astro.url.searchParams;
const tab: Tab = (["program", "majors", "all"] as const).find((t) => t === params.get("tab")) ?? "program";
const semesterId = Astro.params.semester ?? "";
let view = planView(semesterId, tab === "majors" ? (params.get("major") ?? undefined) : undefined);
// the Majors tab opens on the one the student is closest to
if (view && tab === "majors" && !view.major && view.majors[0]) view = planView(semesterId, view.majors[0].stream.code);

const sections = [
  { slug: "", label: "Overview" },
  { slug: "add", label: "Add Course" },
];
const current = sections.findIndex((s) => s.slug === (Astro.params.section ?? ""));
if (!view || current === -1) return new Response("Not found", { status: 404 });

const selected = params.get("course")?.trim().toUpperCase() || undefined;
const semesterBase = `/plan/${view.semester.id}/`;
const base = semesterBase + (sections[current]!.slug ? `${sections[current]!.slug}/` : "");
const where: Record<string, string> = { tab, ...(view.major ? { major: view.major.code } : {}) };
const isCurrent = currentSemester()?.id === view.semester.id;
const choosing = !view.program || params.get("change") === "program";

const added = params.get("added");
const justSubmitted = params.has("submitted");
const refused = params.get("refused");
const refusal = refused ? canAdd(view, refused) : undefined;
---

<CanvasLayout
  title={`${sections[current]!.label} · ${view.semester.label}`}
  crumb={view.semester.label}
  sections={{
    name: view.semester.label,
    term: formatRange(view.semester),
    items: sections.map((s) => ({ href: semesterBase + (s.slug ? `${s.slug}/` : ""), label: s.label })),
    current,
  }}
>
  <h1>{current === 0 ? view.semester.label : "Add Course"}</h1>
  <PlanHeader view={view} isCurrent={isCurrent} />
  <PlanSteps view={view} base={base} choosing={choosing} />

  {added && <p class="notice" role="status">Added {added} {getCourse(added)?.title} to your selection.</p>}
  {justSubmitted && <p class="notice" role="status">Submitted — you're enrolled in {view.planned.length} courses for {view.semester.label}.</p>}
  {
    !choosing && view.drafts.length > 0 && (
      <p class="notice notice-warn" role="status">
        {view.drafts.map((d) => d.label).join(", ")} {view.drafts.length === 1 ? "isn't" : "aren't"} submitted yet, so{" "}
        {view.drafts.length === 1 ? "its" : "their"} courses don't count here.{" "}
        <a href={`/plan/${view.drafts[0]!.id}/add/`}>Finish {view.drafts[0]!.label}</a>
      </p>
    )
  }
  {refusal && !refusal.ok && <p class="notice notice-warn" role="status">Couldn't add {refused}: {refusal.reason}</p>}

  {
    !choosing && current === 1 && (
      <>
        <PlanIntro view={view} majorsHref={`${base}?tab=majors`} />
        <SelectionBar view={view} back={Astro.url.pathname + Astro.url.search} />
      </>
    )
  }

  {
    !choosing && (
      <div class="plan-columns">
        <SkillTree view={view} tiers={tiers(view, tab)} tab={tab} selected={selected} base={base} mode={current === 0 ? "overview" : "add"} />
        <aside class="plan-aside" aria-label={current === 0 ? "Course and requirements" : "Course and this semester"}>
          {selected && (
            <CourseDetail
              view={view}
              code={selected}
              mode={current === 0 ? "overview" : "add"}
              base={base}
              where={where}
              addHref={`${semesterBase}add/`}
            />
          )}
          {current === 0 ? (
            <RequirementTracker
              view={view}
              majorsHref={`${base}?tab=majors`}
              courseHref={(code) => `${base}?${new URLSearchParams({ ...where, course: code })}#course-detail`}
            />
          ) : (
            !selected && (
              <section class="panel detail-hint" aria-label="Course details">
                <p>Click a course in the tree to see its prerequisites and add it to this semester.</p>
              </section>
            )
          )}
        </aside>
      </div>
    )
  }
</CanvasLayout>

<script>
  // Picking courses reloads the page (a tile's link, Add, Remove, Submit), and
  // each reload would jump to #course-detail. Keep the page where it was
  // instead: remember the scroll before leaving, put it back on arrival. Only
  // while the side panel is sticky (wide screens), where the detail is in view
  // anyway; on a phone the jump down to the detail is the point. Storage can
  // be missing (private windows), so fail quietly.
  const KEY = "plan-scroll";
  const aside = document.querySelector(".plan-aside");
  const sticky = () => !!aside && getComputedStyle(aside).position === "sticky";
  const remember = () => {
    try {
      sessionStorage.setItem(KEY, JSON.stringify({ path: location.pathname, y: scrollY }));
    } catch {}
  };
  document.addEventListener("click", (e) => {
    if ((e.target as Element).closest(".tile, .slot-course")) remember();
  }, true);
  document.addEventListener("submit", remember, true);

  let saved: { path: string; y: number } | null = null;
  try {
    saved = JSON.parse(sessionStorage.getItem(KEY) ?? "null");
    sessionStorage.removeItem(KEY);
  } catch {}
  if (saved && saved.path === location.pathname && sticky()) {
    const y = saved.y;
    history.replaceState(null, "", location.pathname + location.search);
    scrollTo(0, y);
    addEventListener("load", () => scrollTo(0, y), { once: true });
  }
</script>
